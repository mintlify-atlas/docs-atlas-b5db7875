  "keyFeatures": [
    "Multi-format forensic evidence ingestion (EVTX, MFT, CSV, XLSX, JSON, Plist)",
    "Real-time Sigma and YARA threat detection with 86+ rules",
    "Interactive timeline visualization with risk scoring",
    "MITRE ATT&CK framework mapping and TTP analysis",
    "Advanced filtering and search capabilities",
    "Multi-format export (PDF, HTML, CSV, XLSX, JSON)",
    "Chain of custody with SHA256 hashing",
    "Streaming upload for 6GB+ files"
  ],
  "publicApiSurface": [
    "/upload - Upload forensic artifacts",
    "/api/data/{filename} - Retrieve parsed data",
    "/api/forensic_report - Generate forensic analysis",
    "/api/export_filtered - Export filtered results",
    "/api/export/html - Generate HTML report",
    "/api/export/pdf - Generate PDF report",
    "/api/histogram/{filename} - Get timeline histogram",
    "/api/reset - Hard reset application state"
